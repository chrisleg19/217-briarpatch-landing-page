# =============================================================================
# Marketing Ops Dashboard - environment variables
# Copy this file to ".env.local" and fill in the values you have.
# The app runs in DEMO MODE (sample data) until GOOGLE_* + AUTH_SECRET are set.
# =============================================================================

# --- App URL & auth session -------------------------------------------------
# Your deployed URL (or http://localhost:3000 locally).
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# A random secret for signing sessions. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth (Gmail, Calendar, Forms, Sheets) --------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini AI (email draft writing) ----------------------------------------
# Free key from https://aistudio.google.com/app/apikey  (optional: falls back
# to a built-in template if unset).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Google Forms / Sheets --------------------------------------------------
# Preferred: the ID of the Google Sheet your Form responses are linked to
# (from the sheet URL: /spreadsheets/d/THIS_PART/edit).
RESPONSES_SHEET_ID=
# Alternative: the Google Form ID (from the form edit URL).
GOOGLE_FORM_ID=

# --- Calendar / showings ----------------------------------------------------
# Calendar to read showings from ("primary" is your main calendar).
SHOWING_CALENDAR_ID=primary
# Public Google Calendar "appointment schedule" link prospects use to self-book.
BOOKING_LINK=

# --- SMS to prospects (Twilio) ----------------------------------------------
# From https://console.twilio.com  (optional: sends are simulated if unset).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The lock box code that pre-fills the lock box text message.
LOCKBOX_CODE=

# --- Persistence (optional) -------------------------------------------------
# Supabase stores which emails have been replied to / dismissed. Optional:
# without it, that state is kept in memory for the current session only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Business context (used in AI drafts, confirmations, texts) -------------
BUSINESS_NAME=Legette Legacy Group LLC
AGENT_NAME=LLG Leasing
AGENT_PHONE=404-590-0295
PROPERTY_ADDRESS=217 Briarpatch Ct, Stockbridge, GA 30281
PROPERTY_RENT=$1,900/month

# --- Optional overrides ------------------------------------------------------
# Force sample data (true) or force live mode (false). Leave unset to auto-detect.
# DEMO_MODE=
